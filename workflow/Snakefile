# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


configfile: "config/config.yaml"


pepfile: config["pepfile"]
containerized: "containerization/qc_container.sif"


include: "rules/common.smk"
include: "rules/contamination.smk"
include: "rules/preprocessed.smk"
include: "rules/qc.smk"
include: "rules/species_diversity.smk"
include: "rules/report.smk"


if config["sample-sheet"]["auto-creation"]:

    include: "rules/preprocessing.smk"


DATE = get_run_date()

if config["testing"]:

    rule all:
        input:
            expand(
                "results/{date}/report/kaiju/merged.kaiju_{level}.tsv",
                date=DATE,
                level=get_tax_levels(),
            ),
            expand("results/{date}/report/qc/multiqc.html", date=DATE),
            expand("results/{date}/report/plots/read_summary.html", date=DATE),
            expand("results/{date}/report/plots/human_contamination.html", date=DATE),
            expand("results/{date}/report/plots/domain_abundance.html", date=DATE),
            expand("results/{date}/report/plots/genus_abundance.html", date=DATE),

else:

    rule all:
        input:
            # Core aggregate outputs, requested EXPLICITLY. These used to be pulled
            # in only indirectly, as inputs of the report.zip rule -- with the
            # report now optional they must be named here, or turning it off would
            # silently drop multiqc, the plots and (critically) qc_metrics.tsv,
            # which is what feeds the registry.
            expand("results/{date}/report/qc_metrics.tsv", date=DATE),
            expand("results/{date}/report/filtering_summary/", date=DATE),
            expand("results/{date}/report/qc/multiqc.html", date=DATE),
            expand("results/{date}/report/plots/read_summary.html", date=DATE),
            expand("results/{date}/report/plots/human_contamination.html", date=DATE),
            # The bundled HTML report is optional (emit-report, default False):
            # cosmetic, but the most failure-prone step (nested `snakemake
            # --report` in the container) -- a failure there used to fail the
            # whole run even though all the QC work had succeeded.
            *(
                expand("results/{date}/report/{date}_report.zip", date=DATE)
                if emit_report()
                else []
            ),
            expand(
                "results/{date}/report/kaiju/merged.kaiju_{level}.tsv",
                date=DATE,
                level=get_tax_levels(),
            ),
            # preprocessed (trimmed [+ host-removed]) reads to hand back to the
            # type pipelines; run_qc.sh deposits these into <type>/fastq/preprocessed/.
            # Skipped when emit-preprocessed is False (e.g. 16S: QC metrics only).
            *(
                expand(
                    "results/{date}/preprocessed/{sample}.{read}.fastq.gz",
                    date=DATE,
                    sample=get_samples(),
                    read=["1", "2"],
                )
                if emit_preprocessed()
                else []
            ),


onsuccess:
    print("Workflow finished without an error.")
    if os.path.exists("results/{date}/report/{date}_report.zip".format(date=DATE)):
        shell("cd results/{DATE}/ && tar cpfz {DATE}_results.tar.gz report/")
        print("You can find the results in {date}_results.tar.gz".format(date=DATE))



onerror:
    print("An error occurred")
